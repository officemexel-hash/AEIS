{
  "__inputs": [{"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus"}],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}
  ],
  "title": "SYLION — Funding autopilot",
  "uid": "sylion-funding",
  "description": "Phase 3 W3.1 — funding portal scans, submissions, latency, mobile push.",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 38,
  "tags": ["sylion", "phase3", "funding"],
  "time": {"from": "now-3h", "to": "now"},
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Calls scanned per program (5m rate)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "id": 1,
      "targets": [
        {"expr": "60 * sum by (program) (rate(aeis_funding_calls_scanned_total[5m]))", "refId": "A", "legendFormat": "{{program}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Submissions per program (5m rate)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "id": 2,
      "targets": [
        {"expr": "60 * sum by (program, outcome) (rate(aeis_funding_submissions_total[5m]))", "refId": "A", "legendFormat": "{{program}} ({{outcome}})"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Funding plane p95 latency",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "id": 3,
      "targets": [
        {"expr": "sylion:latency:p95{layer=\"funding\"}", "refId": "A", "legendFormat": "p95"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Mobile push outcomes",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "id": 4,
      "targets": [
        {"expr": "sum by (outcome) (rate(aeis_mobile_notifications_sent_total[5m]))", "refId": "A", "legendFormat": "{{outcome}}"}
      ]
    }
  ]
}
