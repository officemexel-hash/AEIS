{
  "__inputs": [{"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus"}],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}
  ],
  "title": "SYLION — SLO burn rate",
  "uid": "sylion-slo-burn",
  "description": "Phase 3 W3.2 — multi-window SLO burn-rate visualisation (target 99.5%).",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 38,
  "tags": ["sylion", "phase3", "slo"],
  "time": {"from": "now-24h", "to": "now"},
  "refresh": "1m",
  "panels": [
    {
      "type": "timeseries",
      "title": "Error rate — 5m vs 30m vs 6h vs 3d",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 10},
      "id": 1,
      "targets": [
        {"expr": "sylion:error_rate:5xx", "refId": "A", "legendFormat": "5m {{endpoint}}"},
        {"expr": "sylion:error_rate:5xx_30m", "refId": "B", "legendFormat": "30m {{endpoint}}"},
        {"expr": "sylion:error_rate:5xx_6h", "refId": "C", "legendFormat": "6h {{endpoint}}"},
        {"expr": "sylion:error_rate:5xx_3d", "refId": "D", "legendFormat": "3d {{endpoint}}"}
      ]
    },
    {
      "type": "stat",
      "title": "Fast burn (1h, threshold 14.4x)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 0, "y": 10, "w": 8, "h": 6},
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "thresholds": {"steps": [{"value": null, "color": "green"}, {"value": 0.072, "color": "red"}]}
        }
      },
      "targets": [{"expr": "max(sylion:error_rate:5xx)", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Slow burn (6h, threshold 6x)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 8, "y": 10, "w": 8, "h": 6},
      "id": 3,
      "fieldConfig": {
        "defaults": {
          "thresholds": {"steps": [{"value": null, "color": "green"}, {"value": 0.030, "color": "yellow"}]}
        }
      },
      "targets": [{"expr": "max(sylion:error_rate:5xx_6h)", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Cumulative (3d, target 0.5%)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 16, "y": 10, "w": 8, "h": 6},
      "id": 4,
      "fieldConfig": {
        "defaults": {
          "thresholds": {"steps": [{"value": null, "color": "green"}, {"value": 0.005, "color": "yellow"}]}
        }
      },
      "targets": [{"expr": "max(sylion:error_rate:5xx_3d)", "refId": "A"}]
    }
  ]
}
