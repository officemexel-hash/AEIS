{
  "__inputs": [{"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus"}],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}
  ],
  "title": "SYLION — Skills runtime",
  "uid": "sylion-skills",
  "description": "Phase 3 W3.1 — skills runtime (per-skill latency, executions, sandbox saturation).",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 38,
  "tags": ["sylion", "phase3", "skills"],
  "time": {"from": "now-1h", "to": "now"},
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Skill p95 by skill_id",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 8},
      "id": 1,
      "targets": [
        {"expr": "sylion:skill_latency:p95", "refId": "A", "legendFormat": "{{skill_id}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Skill executions / minute",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "id": 2,
      "targets": [
        {"expr": "60 * sum by (skill_id) (rate(aeis_skill_executions_total[5m]))", "refId": "A", "legendFormat": "{{skill_id}}"}
      ]
    },
    {
      "type": "stat",
      "title": "Skills loaded",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 12, "y": 8, "w": 6, "h": 8},
      "id": 3,
      "targets": [{"expr": "aeis_skill_loaded_count", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Worker pool size",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"x": 18, "y": 8, "w": 6, "h": 8},
      "id": 4,
      "targets": [{"expr": "aeis_worker_pool_size", "refId": "A"}]
    }
  ]
}
