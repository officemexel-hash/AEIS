+def _backup_db_before_migration(source_conn: sqlite3.Connection) -> None:
+    """v5.8.9 M-08: WAL-safe backup before applying a migration.
+
+    Uses sqlite3 online backup API (sqlite3_backup_*) which works even while
+    the DB is in WAL mode and the source connection is open. Destination is
+    ``~/sylion/sylion.db.bak.v5.8.9.<YYYY-MM-DD>.sqlite3``.
+
+    Security3 F-04 guard: resolved destination MUST be under the backup dir
+    (prevents symlink/parent-traversal shenanigans if HOME is misconfigured).
+    """
+    version_tag = "v5.8.9"
+    date_str = datetime.date.today().isoformat()
+    backup_dir = Path.home() / "sylion"
+    backup_dir.mkdir(parents=True, exist_ok=True)
+    backup_path = backup_dir / f"sylion.db.bak.{version_tag}.{date_str}.sqlite3"
+
+    # F-04: ensure resolved path stays inside the backup dir.
+    try:
+        backup_path.resolve().relative_to(backup_dir.resolve())
+    except ValueError:
+        raise RuntimeError(
+            f"M-08: refusing backup to suspicious path {backup_path}"
+        )
+
+    logger.info("M-08: creating WAL-safe backup → %s", backup_path)
+    try:
+        dest_conn = sqlite3.connect(str(backup_path))
+        try:
+            source_conn.backup(dest_conn)
+        finally:
+            dest_conn.close()
+        logger.info("M-08: backup complete → %s", backup_path)
+    except sqlite3.OperationalError:
+        logger.exception("M-08: backup FAILED → %s — aborting migration", backup_path)
+        raise
+
