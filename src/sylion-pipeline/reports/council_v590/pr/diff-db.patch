+def prune_audit_log(conn: sqlite3.Connection | None = None) -> int:
+    """v5.8.9 M-03: delete audit_log rows older than AUDIT_LOG_RETENTION_DAYS.
+
+    Batched (1000 rows / tx) to avoid long locks under WAL. Returns total deleted.
+    """
+    own = conn is None
