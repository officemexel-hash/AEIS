+        conn = get_conn()
+    try:
+        days = _get_retention_days(
+            conn, "AUDIT_LOG_RETENTION_DAYS", _AUDIT_LOG_RETENTION_DEFAULT
+        )
+        cutoff = time.time() - days * 86400
+        total = 0
+        while True:
+            cur = conn.execute(
+                "DELETE FROM audit_log WHERE id IN "
+                "(SELECT id FROM audit_log WHERE ts < ? LIMIT 1000)",
+                (cutoff,),
+            )
+            conn.commit()
+            deleted = cur.rowcount or 0
+            total += deleted
+            if deleted < 1000:
+                break
+        if total:
+            logger.info("M-03: prune_audit_log deleted %d rows (>%d days)",
+                        total, days)
+        return total
+    finally:
+        if own:
+            conn.close()
+
