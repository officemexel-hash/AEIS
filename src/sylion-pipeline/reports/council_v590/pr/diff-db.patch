+def _run_migrations(conn: sqlite3.Connection, db_path: Path) -> int:
+    """v5.8.9 M-02: versioned migration runner using PRAGMA user_version.
+
+    Reads current user_version, applies migrations in ascending order up to
+    ``_DB_TARGET_VERSION``. Creates a WAL-safe backup **before the first**
+    applied migration. Each migration commits its own `PRAGMA user_version = N`
+    inside the same transaction (BEGIN EXCLUSIVE).
+
+    Returns number of migrations applied (0 if already at target).
+    Raises RuntimeError if DB is newer than code (downgrade refused).
+    """
+    current = conn.execute("PRAGMA user_version").fetchone()[0]
+    target = _DB_TARGET_VERSION
+
+    if current > target:
+        raise RuntimeError(
+            f"M-02: DB at user_version={current} is newer than code target={target}. "
+            "Downgrade refused — upgrade the SYLION code or restore from backup."
+        )
+    if current == target:
+        logger.debug("M-02: DB already at user_version=%d, no migrations", current)
+        return 0
+
+    # Backup before the very first migration of this run.
+    _backup_db_before_migration(conn)
+
+    applied = 0
+    for version in range(current + 1, target + 1):
+        migration = _MIGRATIONS.get(version)
+        if migration is None:
+            raise RuntimeError(f"M-02: no migration registered for version {version}")
+        logger.info("M-02: applying migration → user_version=%d (%s)",
+                    version, migration.__name__)
+        conn.execute("BEGIN EXCLUSIVE")
+        try:
+            migration(conn)
+            conn.execute(f"PRAGMA user_version = {version}")
+            conn.commit()
+            applied += 1
+            logger.info("M-02: migration → user_version=%d committed", version)
+        except Exception:
+            conn.rollback()
+            logger.exception("M-02: migration → user_version=%d FAILED, rolled back", version)
+            raise
+    return applied
+
