+# v5.8.9 M-03: configurable retention helpers (RODO art.5.1.e).
+def _get_retention_days(
+    conn: sqlite3.Connection, key: str, default: int
+) -> int:
+    """Read retention window from config table. Rejects ≤0 / non-numeric → default."""
+    try:
+        row = conn.execute(
+            "SELECT value FROM config WHERE key = ?", (key,)
+        ).fetchone()
+    except sqlite3.OperationalError:
+        return default
+    if not row:
+        return default
+    raw = row["value"] if isinstance(row, sqlite3.Row) else row[0]
+    try:
+        n = int(str(raw).strip())
+    except (TypeError, ValueError):
+        logger.warning("M-03: non-numeric retention %s=%r, using default %d",
+                       key, raw, default)
+        return default
+    if n <= 0:
+        logger.warning("M-03: retention %s=%d ≤ 0, using default %d", key, n, default)
+        return default
+    return n
+
