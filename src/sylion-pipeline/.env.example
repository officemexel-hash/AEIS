# =============================================================================
# SYLION Pipeline — .env.example  (v592)
# =============================================================================
#
# Skopiuj ten plik do .env i uzupełnij wymagane wartości.
# Zmienne oznaczone [REQUIRED] muszą być ustawione przed uruchomieniem.
# Pozostałe mają sensowne wartości domyślne wbudowane w kod.
#
# Wygenerowane przez: scripts/env_lint.py  (drift audit v592)
# Data: 2026-04-19
# =============================================================================


# =============================================================================
# === LLM API Keys ===
# =============================================================================
# Potrzebujesz co najmniej jednego klucza. Minimum: ANTHROPIC_API_KEY.
# Pipeline automatycznie pominie modele, dla których brak klucza.

# Anthropic — Claude Sonnet 4, Claude Opus 4, Claude Haiku 3.5  [REQUIRED minimum]
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — GPT-5, GPT-4.1, o3, GPT-4.1 Mini
OPENAI_API_KEY=sk-...

# Google AI — Gemini 2.5 Pro, Gemini 2.5 Flash
GOOGLE_API_KEY=AIza...

# xAI — Grok 3, Grok 3 Mini (z wyszukiwaniem web)
XAI_API_KEY=xai-...

# DeepSeek — DeepSeek V3, DeepSeek R1
DEEPSEEK_API_KEY=sk-...

# Perplexity — Sonar Pro, Sonar (wyszukiwanie online)
PERPLEXITY_API_KEY=pplx-...

# OpenHands Cloud — jeden klucz, wszystkie modele (alternatywa)
# OPENHANDS_API_KEY=oh-...


# =============================================================================
# === Core Pipeline ===
# =============================================================================

# Minimalny konsensus do akceptacji finding'u (int, default: 3)
CONSENSUS_THRESHOLD=3

# Maksymalna liczba kroków agenta na etap (int, default: 50)
MAX_AGENT_STEPS=50

# Katalog wyników  (default: ./results)
RESULTS_DIR=./results

# Katalog pamięci agentów (default: ./memory)
MEMORY_DIR=./memory

# Ile modeli weryfikuje każdy wynik (int, default: 3)
VERIFY_COUNT=3

# Minimum zgodności weryfikatorów (float 0.0–1.0, default: 0.66)
MIN_AGREEMENT=0.66

# Dzienny limit kosztów API w USD (float, default: 50.0)
MAX_COST_USD_PER_DAY=50.0

# Próg ostrzeżenia o budżecie (float 0.0–1.0, default: 0.80)
BUDGET_WARNING_THRESHOLD=0.80

# Minimalna liczba slotów pipeline (int, default: 3)
PIPELINE_MIN_SLOTS=3


# =============================================================================
# === Dashboard ===
# =============================================================================

# Port serwera dashboard (int, default: 8421)
DASHBOARD_PORT=8421

# Adres nasłuchiwania dashboard (default: 127.0.0.1 — tylko localhost)
DASHBOARD_HOST=127.0.0.1

# Liczba procesów worker Gunicorn (int, default: 1)
WEB_CONCURRENCY=1

# Wewnętrzny klucz API (używany przez orchestrator i dashboard) [REQUIRED w prod]
SYLION_INTERNAL_API_KEY=

# JWT secret (wymagany w production, fallback derived from SYLION_INTERNAL_API_KEY + sha256)
# Wygeneruj: python -c "import secrets; print(secrets.token_hex(32))"
SYLION_JWT_SECRET=

# Wersja aplikacji (domyślnie 5.9.3)
SYLION_VERSION=6.0.0

# Środowisko: production|staging|development
SYLION_ENV=development

# Guard dla default API keys w production (opcjonalny, false by default)
# Ustaw na 'true' tylko w zamkniętym środowisku gdzie hardcoded keys są celowe
SYLION_ALLOW_DEFAULT_KEYS=

# Katalog domowy Sylion (default: ~/sylion)
SYLION_HOME=

# Wymagaj HTTPS dla session cookie (1=tak, 0=wyłącz dla local HTTP dev; default: 1)
SESSION_COOKIE_SECURE=1

# Uruchom zewnętrzny dashboard zamiast wbudowanego (1=tak; default: unset)
# SYLION_EXTERNAL_DASHBOARD=1


# Katalog workspace dla uploadów kodu (default: <pipeline_dir>/workspace_uploads)
SYLION_UPLOADS_DIR=


# =============================================================================
# === Logging ===
# =============================================================================

# Poziom logowania (DEBUG, INFO, WARNING, ERROR; default: INFO)
LOG_LEVEL=INFO

# Zapisz logi do pliku w SYLION_HOME/logs/ (1=tak; default: unset)
# SYLION_LOG_FILE=1

# Formatuj logi jako JSON (1=tak; default: unset)
# SYLION_LOG_JSON=1


# =============================================================================
# === SDR / RF ===
# =============================================================================

# Tryb BTS: zmq=symulacja, rf=prawdziwy RF (wymaga klatki Faradaya; default: zmq)
SYLION_BTS_MODE=zmq

# Moc nadawania dBm (tylko tryb rf; default: -10)
SYLION_TX_GAIN=-10

# Potwierdzenie klatki Faradaya — musi być "yes" dla trybu rf [REQUIRED jeśli rf]
# SYLION_FARADAY_CONFIRMED=yes

# Ścieżka do phantoma SDR (ustawiana automatycznie przez orchestrator)
# SYLION_PHANTOM_PATH=


# =============================================================================
# === Ollama (lokalny LLM — zero kosztów API) ===
# =============================================================================

# Adres API serwera Ollama (default: http://localhost:11434)
# Uruchom serwer: ollama serve
OLLAMA_API_BASE=http://localhost:11434

# Opcjonalny dummy key (ignorowany przez Ollama, wymagany przez litellm)
# OLLAMA_API_KEY=ollama


# =============================================================================
# === Fact Checker (Layer 5 Anti-Hallucination) ===
# =============================================================================

# Model LiteLLM używany przez FactCheckerAgent (default: anthropic/claude-sonnet-4-6)
FACT_CHECKER_MODEL_ID=anthropic/claude-sonnet-4-6

# Włącz Fact Checker (true/false; default: true)
FACT_CHECKER_ENABLED=true

# Alias modelu fact-checkera (short name; default: claude)
FACT_CHECKER_MODEL=claude

# Maks. liczba itemów do sprawdzenia na run (int; default: 50)
FACT_CHECKER_MAX_ITEMS=50

# Liczba linii kontekstu do pobierania (int; default: 20)
FACT_CHECKER_CONTEXT_LINES=20


# =============================================================================
# === Feature Flags ===
# =============================================================================

# Włącz weryfikację buildu przed deployem (true/false; default: true)
BUILD_VERIFICATION_ENABLED=true

# Uruchom testy w ramach weryfikacji buildu (true/false; default: true)
BUILD_RUN_TESTS=true

# Timeout testów [s] (int; default: 120)
BUILD_TEST_TIMEOUT_S=120

# Timeout vet [s] (int; default: 30)
BUILD_VET_TIMEOUT_S=30

# Timeout builda [s] (int; default: 60)
BUILD_BUILD_TIMEOUT_S=60

# Włącz provenance claiming (true/false; default: true)
CLAIM_PROVENANCE_ENABLED=true

# Okno kontekstu provenance (int; default: 10)
PROVENANCE_CONTEXT_WINDOW=10

# Min. ratio dopasowania provenance (float; default: 0.3)
PROVENANCE_MIN_MATCH_RATIO=0.3

# Włącz semantyczną deduplikację (true/false; default: true)
SEMANTIC_DEDUP_ENABLED=true

# Próg podobieństwa deduplikacji (float 0.0–1.0; default: 0.75)
DEDUP_SIMILARITY_THRESHOLD=0.75

# Model sentence-transformers do deduplikacji (default: all-MiniLM-L6-v2)
DEDUP_MODEL_NAME=all-MiniLM-L6-v2

# Włącz benchmark harness (true/false; default: true)
BENCHMARK_ENABLED=true

# Katalog wyjściowy benchmarku (default: "" — używa RESULTS_DIR)
# BENCHMARK_OUTPUT_DIR=

# Progi benchmarku [ms / pct]
BENCH_SETUP_P95_MS=2000
BENCH_INPUT_PHOTON_P95_MS=100
BENCH_ABR_RAMPUP_MS=5000
BENCH_RECONNECT_P95_MS=4000
BENCH_FRAME_DROP_FAIL_PCT=0.05
BENCH_AV_SYNC_FAIL_MS=80


# =============================================================================
# === Streaming ===
# =============================================================================

# Progi latencji [ms]
STREAM_LATENCY_P50_MS=80
STREAM_LATENCY_P95_MS=150
STREAM_LATENCY_P99_MS=300
STREAM_INPUT_LATENCY_MS=50

# Maks. frame drop [%] (float; default: 1.0)
STREAM_FRAME_DROP_MAX_PCT=1.0

# Maks. AV sync drift [ms] (int; default: 50)
STREAM_AV_SYNC_DRIFT_MS=50

# Timeout reconnect [s] (int; default: 3)
STREAM_RECONNECT_TIMEOUT_S=3

# Fallback turn latency [s] (int; default: 5)
STREAM_TURN_FALLBACK_S=5

# Bitrate min/max [kbps]
STREAM_MIN_BITRATE_KBPS=500
STREAM_MAX_BITRATE_KBPS=8000

# Target FPS (int; default: 30)
STREAM_TARGET_FPS=30

# Maks. rozdzielczość (default: 1920x1080)
STREAM_MAX_RESOLUTION=1920x1080

# Kodeki
STREAM_CODEC_VIDEO=H.264
STREAM_CODEC_AUDIO=Opus

# Próbkowanie Opus [Hz] (int; default: 48000)
STREAM_OPUS_SAMPLE_RATE=48000

# Próg baterii poniżej którego redukuj jakość [%] (int; default: 20)
STREAM_BATTERY_THRESHOLD_PCT=20


# =============================================================================
# === Signaling Server ===
# =============================================================================

# Maks. liczba aktywnych pokoi (int; default: 50)
SIGNALING_MAX_ROOMS=50

# Interwał heartbeat [s] (int; default: 10)
SIGNALING_HEARTBEAT_S=10

# Timeout nieaktywnego pokoju [s] (int; default: 30)
SIGNALING_STALE_TIMEOUT_S=30

# STUN server URL (default: stun:stun.l.google.com:19302)
SIGNALING_STUN_URLS=stun:stun.l.google.com:19302

# TURN server URL (opcjonalne, default: "")
SIGNALING_TURN_URLS=

# TURN username (opcjonalne)
SIGNALING_TURN_USERNAME=

# TURN credential (opcjonalne) — przechowuj w secrets managera!
SIGNALING_TURN_CREDENTIAL=


# =============================================================================
# === Stream Security ===
# =============================================================================

# Tryb produkcyjny (wymusza silne szyfrowanie; true/false; default: true)
STREAM_SECURITY_PROD=true

# Blokuj słabe szyfry (true/false; default: true)
STREAM_SECURITY_WEAK_BLOCK=true

# Wymagaj relay (true/false; default: true)
STREAM_SECURITY_RELAY_ONLY=true

# Rate limit sygnalizacji [msg/s] (int; default: 50)
STREAM_SECURITY_SIG_RATE=50

# Rate limit data channel [msg/s] (int; default: 200)
STREAM_SECURITY_DC_RATE=200

# Pinned TLS certyfikaty (comma-separated fingerprints; default: "")
STREAM_SECURITY_PINNED_CERTS=


# =============================================================================
# === Audio ===
# =============================================================================

# Bitrate Opus [bps] (int; default: 32000)
AUDIO_OPUS_BITRATE_BPS=32000

# Włącz DTX — Discontinuous Transmission (true/false; default: true)
AUDIO_OPUS_DTX=true

# Jitter buffer [ms] (int; default: 200)
AUDIO_JITTER_BUFFER_MS=200

# Włącz echo cancellation (true/false; default: true)
AUDIO_ECHO_CANCEL=true


# =============================================================================
# === ABR — Adaptive Bitrate ===
# =============================================================================

# Startowy rung ABR (int; default: 1)
ABR_INITIAL_RUNG=1

# Próg wzrostu bitrate (float; default: 1.5 = 150% max rungu)
ABR_RAMP_UP_THRESHOLD=1.5

# Próg spadku bitrate (float; default: 0.8 = 80% min rungu)
ABR_RAMP_DOWN_THRESHOLD=0.8

# Redukcja bitrate przy NACK (float; default: 0.15 = -15%)
ABR_NACK_REDUCTION_PCT=0.15

# Maks. rung przy przegrzaniu (int; default: 1)
ABR_THERMAL_MAX_RUNG=1


# =============================================================================
# === Input Protocol ===
# =============================================================================

# HMAC key dla wejść (default: "" = klucz wbudowany) [REQUIRED w prod]
INPUT_PROTOCOL_HMAC_KEY=

# Okno replay protection [s] (float; default: 5.0)
INPUT_REPLAY_WINDOW_S=5.0

# Maks. rozmiar batcha wejść (int; default: 32)
INPUT_MAX_BATCH_SIZE=32


# =============================================================================
# === Metrics ===
# =============================================================================

# Maks. próbek na metrykę (int; default: 10000)
METRICS_MAX_SAMPLES=10000

# Okno deduplikacji alertów [s] (int; default: 60)
METRICS_ALERT_DEDUP_S=60

# Katalog logów metryk (default: "" — wyłączone)
METRICS_LOG_DIR=


# =============================================================================
# === Device Harness ===
# =============================================================================

# Tryb dry-run — nie wysyłaj poleceń do urządzeń (true/false; default: true)
DEVICE_HARNESS_DRY_RUN=true

# ADB serial Pixel 8 (default: "" = auto-detect)
DEVICE_PIXEL_SERIAL=

# Host routera (default: 192.168.8.1)
DEVICE_ROUTER_HOST=192.168.8.1

# Użytkownik SSH routera (default: root)
DEVICE_ROUTER_USER=root

# Ścieżka do klucza SSH routera (default: "") [REQUIRED jeśli device_harness]
DEVICE_ROUTER_SSH_KEY=
